// bsonjson — Extended JSON v2, both ways, against `std.json`.
//
// Every body is a `todo()`.  The signatures are the design, and the
// compiler checks them as claims; see the README for the stamp.
//
// WHAT EXTENDED JSON IS.  JSON has six value kinds and BSON has
// twenty-one, so a BSON document written as plain JSON loses its types:
// an int32, an int64, a double and a decimal128 all become a number,
// and an ObjectId, a date and a binary payload all become a string or
// vanish.  Extended JSON is MongoDB's answer — a set of reserved
// `$`-prefixed member names that carry the type beside the value, so
// `{"n": {"$numberLong": "9007199254740993"}}` survives a JSON parser
// that would have rounded the number.
//
// TWO FORMS, AND THE CHOICE IS THE CALLER'S.  The specification defines
// **canonical** and **relaxed**, and they are for different jobs.
//
//   * CANONICAL wraps every type, integers included, so the conversion
//     back to BSON reproduces the same element types.  This is the form
//     for a backup, a test fixture and anything a machine reads.
//   * RELAXED writes an int32, an int64 and a double as plain JSON
//     numbers and a date as an ISO 8601 string, so a person can read it
//     and so `jq` can work on it.  It does NOT round-trip: a relaxed
//     `{"n": 1}` converts back to an int32 whatever it started as.
//
// `BsonExtMode` is that choice, and it is a required argument rather
// than a default, because a caller who did not think about it has
// picked wrong half the time.
//
// AGAINST `std.json`, NOT AGAINST A TYPE OF THIS PACKAGE'S OWN.  The
// values here are `JsonValueH`, the standard library's, which is
// already in every consumer's assembly.  A JSON model declared here
// would collide with the one a caller already has and would double the
// number of trees a program that speaks both formats carries.

// Which of the two Extended JSON forms a conversion produces.
//
// ```novo
// use bsonjson
//
// fn main() [io]
//     println(bsonjson.mode_name(BsonCanonicalExt))   // canonical
// ```
pub enum BsonExtMode
    // Every type wrapped, so the conversion back reproduces the element
    // types exactly.  The form for a backup, a fixture, a test vector.
    BsonCanonicalExt
    // Numbers and dates written plainly, so a person and `jq` can read
    // it.  Does not round-trip.
    BsonRelaxedExt

// The mode's name: `"canonical"` or `"relaxed"`.
pub fn mode_name(m: BsonExtMode) -> Str []
    todo("bson-nv.bsonjson.mode_name")

// A document as an Extended JSON object.
//
// ```novo
// use std.json
// use bsonjson
// use bsonvalue
//
// fn main() [io]
//     let j = bsonjson.doc_to_json(bsonvalue.doc(), BsonCanonicalExt)
//     println(json.stringify(j))   // {}
// ```
pub fn doc_to_json(d: BsonDoc, mode: BsonExtMode) -> JsonValueH []
    todo("bson-nv.bsonjson.doc_to_json")

// One value as Extended JSON.
//
// A `BsonString` becomes a JSON string in both modes; a `BsonInt64`
// becomes `{"$numberLong": "…"}` in canonical and a JSON number in
// relaxed; a `BsonDecimal128Value` becomes `{"$numberDecimal": "…"}` in
// both, because JSON has no way to write one plainly.
pub fn value_to_json(v: BsonValue, mode: BsonExtMode) -> JsonValueH []
    todo("bson-nv.bsonjson.value_to_json")

// A document as Extended JSON text.
//
// `json.stringify` over `doc_to_json`, named because it is what a
// caller writing a file actually wants.
//
// ```novo
// use bsonjson
// use bsonvalue
//
// fn main() [io]
//     println(bsonjson.doc_to_text(bsonvalue.doc(), BsonRelaxedExt))   // {}
// ```
pub fn doc_to_text(d: BsonDoc, mode: BsonExtMode) -> Str []
    todo("bson-nv.bsonjson.doc_to_text")

// An Extended JSON object as a document.
//
// ONE FUNCTION FOR BOTH FORMS, because the two are not disjoint: a
// relaxed document may still carry a `$numberDecimal`, and a canonical
// document read by a tolerant reader is a relaxed document with more
// wrappers.  The specification's own parsing rules are "accept either",
// and the mode is only a WRITING choice.
//
// The rule that decides the element type of a plain JSON number is the
// specification's: an integer that fits thirty-two bits is a
// `BsonInt32`, one that fits sixty-four is a `BsonInt64`, and anything
// with a fraction or an exponent is a `BsonDouble`.  A number that fits
// none of those is `BsonUnrepresentableJson`, naming the text, because
// silently rounding an accounting figure is the failure this whole
// format exists to prevent.
//
// ```novo
// use std.json
// use bsonjson
//
// fn main() [io]
//     match json.parse("{\"n\":{\"\$numberLong\":\"12\"}}")
//         None    => println("not JSON")
//         Some(j) =>
//             match bsonjson.doc_from_json(j)
//                 Ok(_)  => println("read")
//                 Err(e) => println(e.message())
// ```
pub fn doc_from_json(j: JsonValueH) -> Result<BsonDoc, BsonError> []
    todo("bson-nv.bsonjson.doc_from_json")

// One Extended JSON value as a BSON value.
pub fn value_from_json(j: JsonValueH) -> Result<BsonValue, BsonError> []
    todo("bson-nv.bsonjson.value_from_json")

// A document from Extended JSON text.
//
// `BsonBadExtendedPayload` with the reason `"not json"` when the text
// does not parse at all, so a caller has one error channel rather than
// an option and a result.
//
// ```novo
// use bsonjson
//
// fn main() [io]
//     match bsonjson.doc_from_text("{}")
//         Ok(_)  => println("read")
//         Err(e) => println(e.message())
// ```
pub fn doc_from_text(text: Str) -> Result<BsonDoc, BsonError> []
    todo("bson-nv.bsonjson.doc_from_text")

// Whether a JSON object is one of the specification's type wrappers —
// an object whose members are the reserved `$`-prefixed names for one
// type and nothing else.
//
// `{"$oid": "…"}` is one; `{"$oid": "…", "x": 1}` is not, and is a
// plain document with a key that begins with a dollar sign.  That
// distinction is the whole of Extended JSON's ambiguity, and this is
// the function that resolves it.
//
// ```novo
// use std.json
// use bsonjson
//
// fn main() [io]
//     match json.parse("{\"\$oid\":\"507f1f77bcf86cd799439011\"}")
//         None    => println("not JSON")
//         Some(j) => println("${bsonjson.is_type_wrapper(j)}")   // true
// ```
pub fn is_type_wrapper(j: JsonValueH) -> Bool []
    todo("bson-nv.bsonjson.is_type_wrapper")

// The reserved member name a BSON type is wrapped under, or `""` for
// the types that have no wrapper because JSON writes them directly —
// string, boolean, null, document and array.
//
// `"$oid"`, `"$numberLong"`, `"$numberInt"`, `"$numberDouble"`,
// `"$numberDecimal"`, `"$binary"`, `"$date"`, `"$timestamp"`,
// `"$regularExpression"`, `"$code"`, `"$symbol"`, `"$dbPointer"`,
// `"$undefined"`, `"$minKey"`, `"$maxKey"`.
//
// ```novo
// use bsonjson
//
// fn main() [io]
//     println(bsonjson.wrapper_name(BsonMinKey))   // $minKey
// ```
pub fn wrapper_name(v: BsonValue) -> Str []
    todo("bson-nv.bsonjson.wrapper_name")

// Whether a value survives the relaxed form unchanged.
//
// False for `BsonInt32`, `BsonInt64`, `BsonDouble` and `BsonDateTime` —
// the four the relaxed form writes plainly and therefore cannot
// reconstruct — and for any document or array containing one.  A caller
// choosing a mode for a file that will be read back asks this, and a
// caller writing a file for a person to read ignores it.
//
// ```novo
// use bsonjson
//
// fn main() [io]
//     println("${bsonjson.relaxed_round_trips(BsonInt64(1))}")   // false
// ```
pub fn relaxed_round_trips(v: BsonValue) -> Bool []
    todo("bson-nv.bsonjson.relaxed_round_trips")
